# Telegram Bot Token
TELEGRAM_BOT_TOKEN=<Telegram Bot Token Here>

# Database configuration
DATABASE_PATH=./data/zdrofit.db

# Logging configuration
LOG_DIR=./logs
LOG_LEVEL=DEBUG

# Zdrofit API configuration
ZDROFIT_API_BASE_URL=https://zdrofit.perfectgym.pl
ZDROFIT_API_TIMEOUT=30

# List of Telegram user IDs that are allowed to use admin commands (comma-separated)
ADMIN_TELEGRAM_IDS=<Telegram User ID 1>,<Telegram User ID 2>

# Scheduler configuration
SCHEDULER_TIMEZONE=Europe/Warsaw
